let player = null;
let videoLoaded = false;

function decodeVideoUrl(encodedData) {
    try {
        const decoded = atob(encodedData);
        const parts = decoded.split('|');
        return parts[0];
    } catch (e) {
        console.error('Failed to decode video URL');
        return null;
    }
}

function isSafari() {
    const userAgent = navigator.userAgent;
    return userAgent.includes('Safari') && 
           !userAgent.includes('Chrome') && 
           !userAgent.includes('Chromium') &&
           !userAgent.includes('Edge');
}

function generateEmbedToken(embedCode) {
    return window.embedToken || null;
}

async function loadAndPlayVideo() {
    if (videoLoaded) return;
    
    document.getElementById("preview-overlay").style.display = "none";
    document.getElementById("loading-overlay").style.display = "flex";
    
    try {
        const headers = {
            'Accept': 'application/json'
        };
        
        if (isSafari()) {
            const embedToken = generateEmbedToken(window.embedCode);
            if (embedToken) {
                headers['X-Embed-Token'] = embedToken;
            }
        }
        
        const response = await fetch("/api.php?code=" + window.embedCode, {
            method: 'GET',
            headers: headers,
            credentials: 'same-origin'
        });
        
        if (!response.ok) {
            throw new Error("Content not available");
        }
        
        const data = await response.json();
        
        if (data.success && data.video_url) {
            const videoUrl = decodeVideoUrl(data.video_url);
            
            if (!videoUrl) {
                throw new Error("Content not available");
            }
            
            await initializePlayer(videoUrl);
            videoLoaded = true;
        } else {
            throw new Error("Content not available");
        }
        
    } catch (error) {
        console.error("Error loading video:", error);
        showError("Content not available");
    }
}

async function initializePlayer(videoUrl) {
    try {
        document.getElementById("loading-overlay").style.display = "none";
        
        const source = document.createElement("source");
        source.src = videoUrl;
        source.type = "video/mp4";
        
        const videoElement = document.getElementById("player");
        videoElement.appendChild(source);
        videoElement.style.display = "block";
        
        player = new Plyr("#player", {
            controls: [
                "play-large",
                "play",
                "progress", 
                "current-time",
                "mute",
                "volume",
                "settings",
                "fullscreen"
            ],
            settings: ["speed"],
            speed: {
                selected: 1,
                options: [0.5, 0.75, 1, 1.25, 1.5, 2]
            },
            ratio: null,
            fullscreen: {
                enabled: true,
                fallback: true,
                iosNative: true
            },
            keyboard: {
                focused: true,
                global: false
            },
            tooltips: {
                controls: false,
                seek: true
            },
            displayDuration: true,
            invertTime: false,
            clickToPlay: true,
            hideControls: true,
            resetOnEnd: false,
            disableContextMenu: false,
            autoplay: true
        });

        player.on("ready", () => {
            player.toggleControls(true);
            player.play();
        });
        
        player.on("error", (event) => {
            showError("Content not available");
        });
        
        videoElement.addEventListener("error", (e) => {
            showError("Content not available");
        });
        
    } catch (error) {
        showError("Content not available");
    }
}

function showError(message) {
    document.getElementById("preview-overlay").style.display = "none";
    document.getElementById("loading-overlay").style.display = "none";
    document.getElementById("error-message").textContent = message;
    document.getElementById("error-overlay").style.display = "flex";
}

function handleResize() {
    if (player) {
        setTimeout(() => {
            if (player.elements && player.elements.container) {
                player.elements.container.style.height = "100%";
            }
        }, 100);
    }
}

window.addEventListener("resize", handleResize);

window.addEventListener("message", (event) => {
    if (event.data.type === "resize" && player) {
        handleResize();
    }
});

document.addEventListener("contextmenu", (e) => {
    if (e.target.tagName === "VIDEO") {
        e.preventDefault();
    }
});

document.getElementById("preview-overlay").addEventListener("contextmenu", (e) => {
    e.preventDefault();
});
