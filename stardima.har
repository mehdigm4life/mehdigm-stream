0645\\u0641\\u0627\\u062c\\u0626 \\u0645\\u0646 \\u0642\\u0650\\u0628\\u0644 \\u0641\\u0636\\u0627\\u0626\\u064a \\u063a\\u0627\\u0645\\u0636 \\u0648\\u0642\\u0648\\u064a \\u0644\\u0644\\u063a\\u0627\\u064a\\u0629 \\u064a\\u062a\\u0646\\u0642\\u0644 \\u0628\\u064a\\u0646 \\u0627\\u0644\\u0623\\u0628\\u0639\\u0627\\u062f \\u064a\\u064f\\u0639\\u0631\\u0641 \\u0628\\u0627\\u0633\\u0645 \\\"\\u0625\\u0644\\u064a\\u064a\\u0646 \\u0625\\u0643\\u0633\\\" (Alien X). \\u064a\\u0642\\u0648\\u0645 \\u0647\\u0630\\u0627 \\u0627\\u0644\\u0641\\u0636\\u0627\\u0626\\u064a \\u0627\\u0644\\u0634\\u0631\\u064a\\u0631 \\u0628\\u0627\\u0644\\u0633\\u0641\\u0631 \\u0639\\u0628\\u0631 \\u0627\\u0644\\u0623\\u0643\\u0648\\u0627\\u0646 \\u0627\\u0644\\u0645\\u0648\\u0627\\u0632\\u064a\\u0629 \\u0644\\u0633\\u0631\\u0642\\u0629 \\u0623\\u062c\\u0647\\u0632\\u0629 \\\"\\u0627\\u0644\\u0623\\u0648\\u0645\\u0646\\u064a\\u062a\\u0631\\u064a\\u0643\\u0633\\\" \\u0648\\u062a\\u062f\\u0645\\u064a\\u0631 \\u0646\\u0633\\u062e \\\"\\u0628\\u0646\\\" \\u0641\\u064a \\u0637\\u0631\\u064a\\u0642\\u0647.\\u0644\\u0645\\u0648\\u0627\\u062c\\u0647\\u0629 \\u0647\\u0630\\u0627 \\u0627\\u0644\\u062a\\u0647\\u062f\\u064a\\u062f \\u0627\\u0644\\u0645\\u062f\\u0645\\u0631\\u060c \\u064a\\u0644\\u062a\\u0642\\u064a \\u0628\\u0646 \\u0628\\u0637\\u0644 \\u0627\\u0644\\u0631\\u0648\\u0627\\u064a\\u0629 \\u0628\\u0646\\u0633\\u062e\\u0629 \\u0628\\u062f\\u064a\\u0644\\u0629 \\u0645\\u0646 \\u062c\\u062f\\u0647 \\\"\\u0645\\u0627\\u0643\\u0633\\\" (\\u0645\\u0627\\u0643\\u0633\\u064a\\u0645\\u064a\\u0644\\u064a\\u0627\\u0646)\\u060c \\u0648\\u0627\\u0644\\u0630\\u064a \\u064a\\u0633\\u0627\\u0639\\u062f\\u0647 \\u0639\\u0644\\u0649 \\u0641\\u062a\\u062d \\u0628\\u0648\\u0627\\u0628\\u0627\\u062a \\u0627\\u0644\\u0623\\u0628\\u0639\\u0627\\u062f \\u0644\\u062c\\u0645\\u0639 \\u062c\\u064a\\u0634 \\u0645\\u0646 \\u0646\\u0633\\u062e \\u0628\\u0646 \\u0648\\u062c\\u0648\\u064a\\u0646 \\u0645\\u0646 \\u0627\\u0644\\u0623\\u0643\\u0648\\u0627\\u0646 \\u0627\\u0644\\u0623\\u062e\\u0631\\u0649 (\\u0628\\u0645\\u0627 \\u0641\\u064a \\u0630\\u0644\\u0643 \\u0646\\u0633\\u062e \\u0645\\u0646 \\u0627\\u0644\\u0633\\u0644\\u0627\\u0633\\u0644 \\u0627\\u0644\\u0643\\u0644\\u0627\\u0633\\u064a\\u0643\\u064a\\u0629 \\u0627\\u0644\\u0634\\u0647\\u064a\\u0631\\u0629 \\u0645\\u062b\\u0644 Alien Force \\u0648 Ultimate Alien \\u0648 Omniverse) \\u0644\\u062a\\u0648\\u062d\\u064a\\u062f \\u0642\\u0648\\u0627\\u0647\\u0645 \\u0648\\u0647\\u0632\\u064a\\u0645\\u0629 \\\"\\u0625\\u0644\\u064a\\u064a\\u0646 \\u0625\\u0643\\u0633\\\".\",\"logo\":null,\"category\":[],\"year\":\"2021\",\"poster_url\":\"https:\\/\\/f5f-efgeg59852-zfz2d-mmltizwwcvb5567r2r63e-zd46.stardima.app\\/storage\\/posters\\/ben-10-alien-x-tinction-portrait.jpg\",\"background_url\":\"https:\\/\\/f5f-efgeg59852-zfz2d-mmltizwwcvb5567r2r63e-zd46.stardima.app\\/storage\\/posters\\/ben-10-alien-x-tinction-portrait.jpg\",\"video_parent\":0,\"video_quality\":\"\\u0645\\u062a\\u0631\\u062c\\u0645\",\"status_text\":\"\\u0645\\u0643\\u062a\\u0645\\u0644\",\"is_series\":false,\"seasons_count\":\"\\u0641\\u064a\\u0644\\u0645\"},{\"id\":3066,\"title\":\"\\u062a\\u0627\\u0646 \\u062a\\u0627\\u0646\",\"description\":\"\\u0645\\u063a\\u0627\\u0645\\u0631\\u0627\\u062a \\u062a\\u0627\\u0646 \\u062a\\u0627\\u0646 \\u0645\\u0633\\u0644\\u0633\\u0644 \\u0631\\u0633\\u0648\\u0645 \\u0645\\u062a\\u062d\\u0631\\u0643\\u0629 \\u0641\\u0631\\u0646\\u0633\\u064a \\u0643\\u0646\\u062f\\u064a \\u0648\\u0647\\u0648 \\u0645\\u0642\\u062a\\u0628\\u0633 \\u0645\\u0646 \\u0631\\u0648\\u0627\\u064a\\u0627\\u062a \\u0645\\u063a\\u0627\\u0645\\u0631\\u0627\\u062a \\u062a\\u0627\\u0646 \\u062a\\u0627\\u0646 \\u0648\\u062a\\u062f\\u0648\\u0631 \\u0623\\u062d\\u062f\\u0627\\u062b \\u0627\\u0644\\u0645\\u0633\\u0644\\u0633\\u0644 \\u0641\\u064a \\u0627\\u0644\\u0642\\u0631\\u0646 \\u0627\\u0644\\u0639\\u0634\\u0631\\u064a\\u0646 \\u0648\\u064a\\u062d\\u0643\\u064a \\u064