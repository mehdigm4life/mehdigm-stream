 }\n\t\t\n\t});\n\tvar current_audio;\n\tfunction audio_set(audio_name)\n\t{\n\t\tvar tracks=player.getAudioTracks();\n\t\tif(tracks.length>1){\n\t\t\tfor(i=0;i<tracks.length;i++){ if(tracks[i].name==audio_name){ if(i==current_audio){return;} current_audio=i; player.setCurrentAudioTrack(i); } }\n\t\t}\n\t}\n\n// SR_LIVE_VIEWERS_V1: this function only observes player events.\n(function (player, token) {\n    'use strict';\n    if (!token || !window.fetch || !window.AbortController) return;\n    var seq = 0, inflight = false, pending = null, lastSent = 0;\n    var progressAt = 0, position = null, inAd = false, playing = false;\n    var ended = false, reported = false, timer = null, failures = 0;\n    var nextDue = 0, destroyed = false;\n    function now() { return Date.now(); }\n    function isActive() {\n        return !ended && !inAd && playing && progressAt > 0 && now() - progressAt < 15000;\n    }\n    function schedule() {\n        clearTimeout(timer);\n        if (!destroyed) timer = setTimeout(tick, 5000);\n    }\n    function send(active) {\n        if (destroyed) return;\n        if (inflight) { pending = active; return; }\n        inflight = true;\n        lastSent = now();\n        nextDue = lastSent + 28000 + Math.floor(Math.random() * 4000);\n        var controller = new AbortController();\n        var timeout = setTimeout(function () { controller.abort(); }, 5000);\n        var body = JSON.stringify({token: token, seq: ++seq, active: active});\n        fetch('/__sr_live/beat', {\n            method: 'POST', headers: {'Content-Type': 'application/json'},\n            body: body, credentials: 'omit', cache: 'no-store', signal: controller.signal\n        }).then(function (r) {\n            if (!r.ok) throw new Error('unavailable');\n            return r.json();\n        }).then(function (r) {\n            if (!r.ok) throw new Error('unavailable');\n            if (typeof r.token === 'string') token = r.token;\n            reported = active;\n            failures = 0;\n        }).catch(function () {\n            failures = Math.min(4, failures + 1);\n            nextDue = now() + Math.min(120000, 15000 * Math.pow(2, failures - 1));\n        }).then(function () {\n            clearTimeout(timeout);\n            inflight = false;\n            // Serialize requests; a queued pause takes priority over an old heartbeat.\n            if (pending !== null) {\n                var requested = pending;\n                pending = null;\n                if (!requested && failures === 0) send(false);\n            }\n        });\n    }\n    function tick() {\n        if (destroyed) return;\n        var active = isActive();\n        if (now() >= nextDue && (active || reported)) send(active);\n        schedule();\n    }\n    function stop() {\n        playing = false;\n        progressAt = 0;\n        position = null;\n        if (reported || inflight) send(false);\n    }\n    player.on('time', function (event) {\n        if (inAd || ended || !playing || typeof event.position !== 'number') return;\n        var advanced = position !== null && event.position > position && event.position - position < 5;\n        position = event.position;\n        if (!advanced) return;\n        progressAt = now();\n        if (now() >= nextDue && !inflight) send(true);\n    });\n    player.on('play', function () {\n        playing = true; ended = false; position = null;\n        if (failures === 0 && !reported) nextDue = 0;\n    });\n    player.on('seek', function () { position = null; progressAt = 0; });\n    player.on('pause', stop);\n    player.on('complete', function () { ended = true; stop(); });\n    player.on('error', stop);\n    player.on('adBreakStart', function () { inAd = true; stop(); });\n    // adPlay also covers preroll integrations that omit adBreakStart.\n    player.on('adPlay', function () { inAd = true; stop(); });\n    function adEnd() {\n        inAd = false;\n        position = null;\n        try { playing = player.getState() === '