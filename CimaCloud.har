ages4/streamruby-brand-kit-v1/player-control-icon-white-48.png\", link:\"https://streamruby.com\", position:\"control-bar\", margin:\"5\"},cast: {},playbackRateControls: true, playbackRates: [0.25,0.5,0.75,1,1.25,1.5,1.75,2]\n  });\nvar vvplay,vvad;\nvar vastdone1=0,vastdone2=0;\nvar player = jwplayer();\n\n// SR_PLAYBACK_QUALITY_V1: isolated observation, no playback/accounting commands.\ntry {\n/* Observation only. No network, storage, player setters, URLs or raw error payloads. */\n(function(global){\n 'use strict';\n const finite=x=>typeof x==='number'&&Number.isFinite(x)&&x>=0;\n const word=x=>typeof x==='string'&&/^[\\w .:-]{1,64}$/.test(x)?x:undefined;\n function create(options={}){\n  const now=options.now||(()=>performance.now()),origin=now();\n  const totals={playing:0,buffering:0,ad:0,paused:0,seeking:0,startup:0};\n  const counts={attempts:0,firstFrames:0,rebuffer:0,seeks:0,errors:0,warnings:0,blocked:0,completions:0,adRequests:0,adImpressions:0,adViewable:0,adComplete:0,adSkipped:0,adErrors:0};\n  let phase='idle',since=origin,attemptAt=null,attemptAdBaseline=0,startup=null,started=false,inAd=false,seeking=false,seekSettled=false,quality=null,stopped=false,stopAt=null;\n  const events=[],limit=Math.min(500,Math.max(20,options.maxEvents||160));let dropped=0;\n  function transition(next,t){if(next===phase)return;if(phase in totals)totals[phase]+=Math.max(0,t-since);phase=next;since=t;}\n  function durations(t){const result={...totals};if(phase in result)result[phase]+=Math.max(0,t-since);return result;}\n  function log(type,data,t){\n   const details={};for(const k of ['code','reason','mode','width','height','bitrate','state','kind'])if(finite(data[k])||word(data[k]))details[k]=data[k];\n   events.push({id:dropped+events.length+1,atMs:Math.round(t-origin),type,...details});if(events.length>limit){events.shift();dropped++;}\n  }\n  function record(type,data={}){\n   if(stopped)return;const t=now();\n   if(type==='buffer')data={...data,kind:inAd?'ad':!started||phase==='startup'?'startup':seeking?'seek':phase==='paused'?'pause':'rebuffer'};\n   if(type==='time'){\n    if(started&&!inAd&&seekSettled&&data.state==='playing'&&phase==='seeking'){seeking=false;transition('playing',t);}return;\n   }\n   switch(type){\n    case 'beforePlay':\n     if(attemptAt===null){attemptAt=t;attemptAdBaseline=durations(t).ad;counts.attempts++;}\n     if(!inAd&&!started)transition('startup',t);break;\n    case 'firstFrame':\n     if(!started){\n      started=true;counts.firstFrames++;\n      if(attemptAt!==null){const elapsed=Math.max(0,t-attemptAt),ad=Math.max(0,durations(t).ad-attemptAdBaseline);startup={wallMs:elapsed,adMs:Math.min(ad,elapsed),contentMs:Math.max(0,elapsed-ad)};}\n      if(finite(data.width)&&finite(data.height))quality={width:data.width,height:data.height,mode:'source'};\n     }\n     if(!inAd){seeking=false;transition('playing',t);}break;\n    case 'play':\n     if(attemptAt===null){attemptAt=t;attemptAdBaseline=durations(t).ad;counts.attempts++;}\n     if(!inAd&&(!seeking||seekSettled)){seeking=false;transition(started?'playing':'startup',t);}break;\n    case 'buffer':\n     if(!inAd&&!seeking&&started&&phase==='playing'){counts.rebuffer++;transition('buffering',t);}\n     break;\n    case 'pause':if(!inAd)transition('paused',t);break;\n    case 'seek':if(!inAd){counts.seeks++;seeking=true;seekSettled=false;transition('seeking',t);}break;\n    case 'seeked':seekSettled=true;if(!inAd&&data.state==='paused'){seeking=false;transition('paused',t);}break;\n    case 'complete':if(!inAd){if(phase!=='ended')counts.completions++;seeking=false;transition('ended',t);}break;\n    case 'error':case 'setupError':counts.errors++;if(!inAd)transition('error',t);break;\n    case 'warning':counts.warnings++;break;\n    case 'playAttemptFailed':case 'autostartNotAllowed':counts.blocked++;if(!started)attemptAt=null;if(!inAd)transition('paused',t);break;\n    case 'visualQuality':\n     quality={};for(const k of ['width','height','bitrate'])if(finite(data[k]))quality[k]=data[k];if(word(data.mode))quality.mode=data.mode;break;\n    case 'adRequest':counts.adRequests++;break;\n    case 'adBreakStart':case 'adPlay':inAd=true;transition('ad',t);break;\n    case 'adImpression':counts.adImpressions++;inAd=true;transition('ad',t);break;\n    case 'adViewableImpression':counts.adViewable++;break;\n    case 'adComplete':counts.adComplete++;break;\n    case 'adSkipped':counts.adSkipped++;break;\n    case 'adError':counts.adErrors++;if(inAd){inAd=false;transition(started?'paused':'startup',t);}break;\n    case 'adBreakEnd':case 'adRequestedContentResume':case 'adBreakIgnored':\n     inAd=false;seeking=false;transition(started?(data.state==='playing'?'playing':'paused'):'startup',t);break;\n    case 'idle':if(!inAd)transition('idle',t);break;\n    case 'ready':case 'levelsChanged':case 'visibility':break;\n    default:return;\n   }\n   log(type,data,t);\n  }\n  function snapshot(){\n   const t=stopped?stopAt:now(),d=durations(t),den=d.playing+d.buffering;\n   return {schema:1,scope:'local-preview-single-media',sessionId:options.sessionId||'local-session',mediaId:options.mediaId||'local-demo',phase,\n    observedMs:Math.round(t-origin),startup:startup&&Object.fromEntries(Object.entries(startup).map(([k,v])=>[k,Math.round(v)])),\n    durationsMs:Object.fromEntries(Object.entries(d).map(([k,v])=>[k,Math.round(v)])),counts:{...counts},rebufferRatio:den>0?d.buffering/den:null,quality:quality&&{...quality},events:events.map(e=>({...e})),droppedEvents:dropped};\n  }\n  return {record,snapshot,stop(){if(!stopped){stopAt=now();stopped=true;}}};\n }\n function attach(player,options={}){\n  const random=global.crypto&&global.crypto.randomUUID?global.crypto.randomUUID():Date.now().toString(36)+'-'+Math.random().toString(36).slice(2);\n  const meter=create({...options,sessionId:random}),handlers=[];\n  const state=()=>{try{return player.getState();}catch(_){return 'unknown';}};\n  const names=['ready','beforePlay','firstFram