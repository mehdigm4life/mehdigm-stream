,"value":"20042026.site"},{"name":"Connection","value":"Keep-Alive"},{"name":"Accept-Encoding","value":"gzip"},{"name":"User-Agent","value":"okhttp/4.10.0"}],"queryString":[],"postData":{"mimeType":"application/x-www-form-urlencoded","text":"title=nar&type=0&sort=1&page=1","params":[]},"headersSize":-1,"bodySize":30},"cache":{},"timings":{"send":0,"wait":323,"receive":0},"serverIPAddress":"188.114.96.5","response":{"_responseAvailable":true,"_originalContentEncoding":"gzip","status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Date","value":"Fri, 27 Nov 2026 14:32:38 GMT"},{"name":"Content-Type","value":"application/json; charset=UTF-8"},{"name":"Connection","value":"keep-alive"},{"name":"Server","value":"cloudflare"},{"name":"vary","value":"Accept-Encoding"},{"name":"Set-Cookie","value":"ci_session=dd8ea4d29e21596b28f7820c9fa48741; expires=Fri, 27 Nov 2026 16:32:38 GMT; Max-Age=7200; path=/; HttpOnly; SameSite=Lax"},{"name":"expires","value":"Thu, 19 Nov 1981 08:52:00 GMT"},{"name":"Cache-Control","value":"no-store, no-cache, must-revalidate"},{"name":"pragma","value":"no-cache"},{"name":"strict-transport-security","value":"max-age=31536000"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"Content-Encoding","value":"gzip"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"Server-Timing","value":"cfCacheStatus;desc=\"DYNAMIC\""},{"name":"Server-Timing","value":"cfEdge;dur=19,cfOrigin;dur=131"},{"name":"Report-To","value":"{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=pYIIcWWAByDBAzZn3RqlSrhyzbJCx1v64NiPDtXqkDQsZyUMOumJBH6vzZOZt43exAOhp3iF3FIkH4ytyHLAMbLnoeytyoCDqNj4V%2Bx%2Fd%2Fd1Nhlrd7UokaM2HQUaiDXF\"}]}"},{"name":"Nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"CF-RAY","value":"a611d7e6df6aaa05-MAD"},{"name":"Content-Length","value":"5641"}],"content":{"size":5641,"mimeType":"application/json","text":"{\"status\":true,\"auth\":false,\"version\":\"3.8\",\"force_update\":0,\"name\":false,\"email\":false,\"photo_url\":false,\"is_subscribed\":false,\"created_date\":false,\"data\":[],\"results\":[{\"id\":\"8316\",\"type\":\"series\",\"name\":\"Naruto SD: Rock Lee no Seishun Full-Power Ninden\",\"poster\":\"https://image.tmdb.org/t/p/w500/4kJRnSOAMYlaA07UzgNkko3wMMH.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/1836hXRxGLS53lImrl3IN002AbD.jpg\",\"overview\":\"أهلاً بكم في قرية الورق المخفية. القرية التي اتخذها أوزوماكي ناروتو، نجم مسلسل \\\"ناروتو\\\"، موطناً له. كل يوم، يقوم عدد لا يحصى من النينجا الأقوياء بمهام ويتدربون لصقل مهاراتهم.\",\"release_date\":\"2012-04-03\",\"year\":2012,\"vote_average\":\"6.4\",\"created_at\":\"2026-07-08 02:51:45\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"6593\",\"type\":\"series\",\"name\":\"Naruto Shippūden\",\"poster\":\"https://image.tmdb.org/t/p/original/bmQi1sfNSlCn79j3DJhH8dGLAeh.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/z0YhJvomqedHF85bplUJEotkN5l.jpg\",\"overview\":\"اوزوماكي ناروتو اصبح الآن اكثر نضجا واكبر عمرا. يسعى لإنقاذ صديقه اوتشيها ساسكي من قبضة أوروتشيمارو. بعد عامين ونصف يعود نارتو أخيراً إلى قريته - كونوها - ويبدأ في وضع طموحاته للعمل، على الرغم من أنه لن يكون سهلاً، حيث أنه جمع عددًا من الأعداء (الأكثر خطورة) مثل الاكاتسكي.\",\"release_date\":\"2007-02-15\",\"year\":2007,\"vote_average\":\"8.5\",\"created_at\":\"2026-07-08 01:55:12\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"6574\",\"type\":\"series\",\"name\":\"Naruto\",\"poster\":\"https://image.tmdb.org/t/p/w500/rZN89Puog5PgKBLnJIyl7vyEReG.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/5F0HVEgkgP99fEWDjPyikGt9jQi.jpg\",\"overview\":\"القرية المخفيّة في الورق هي موطن لأكثر النينجا خفّة وسريّة. لكن قبل اثنتي عشرة سنة، ظهر الثعلب الشيطان ذو التسعة ذيول وبعث الرعب في ساكنيها قبل أن يتمّ كبته وختم روحه في داخل جسد طفلٍ رضيع.\",\"release_date\":\"2002-10-03\",\"year\":2002,\"vote_average\":\"8.3\",\"created_at\":\"2026-07-08 01:54:32\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12812\",\"type\":\"series\",\"name\":\"ناروتو - الأوفا وحلقات خاصة\",\"poster\":\"https://image.tmdb.org/t/p/original/eihbdO1GLufXWuRH96wLGC3enHC.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/5F0HVEgkgP99fEWDjPyikGt9jQi.jpg\",\"overview\":\"القرية المخفيّة في الورق هي موطن لأكثر النينجا خفّة وسريّة. لكن قبل اثنتي عشرة سنة، ظهر الثعلب الشيطان ذو التسعة ذيول وبعث الرعب في ساكنيها قبل أن يتمّ كبته وختم روحه في داخل جسد طفلٍ رضيع.\",\"release_date\":\"2002-10-03\",\"year\":2002,\"vote_average\":\"8.3\",\"created_at\":\"2026-10-19 16:41:36\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12809\",\"type\":\"series\",\"name\":\"أفلام ناروتو شيبودن مترجمة\",\"poster\":\"https://image.tmdb.org/t/p/original/u0NMQoidc4tCnhPtYJc12dmuNBV.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/z0YhJvomqedHF85bplUJEotkN5l.jpg\",\"overview\":\"اوزوماكي ناروتو اصبح الآن اكثر نضجا واكبر عمرا. يسعى لإنقاذ صديقه اوتشيها ساسكي من قبضة أوروتشيمارو. بعد عامين ونصف يعود نارتو أخيراً إلى قريته - كونوها - ويبدأ في وضع طموحاته للعمل، على الرغم من أنه لن يكون سهلاً، حيث أنه جمع عددًا من الأعداء (الأكثر خطورة) مثل الاكاتسكي.\",\"release_date\":\"2007-02-15\",\"year\":2007,\"vote_average\":\"8.5\",\"created_at\":\"2026-10-19 15:41:23\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12808\",\"type\":\"series\",\"name\":\"أفلام ناروتو مترجمة\",\"poster\":\"https://image.tmdb.org/t/p/original/hKhuT00SKH0ocDUOPJSw6ewr4d0.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/5F0HVEgkgP99fEWDjPyikGt9jQi.jpg\",\"overview\":\"القرية المخفيّة في الورق هي موطن لأكثر النينجا خفّة وسريّة. لكن قبل اثنتي عشرة سنة، ظهر الثعلب الشيطان ذو التسعة ذيول وبعث الرعب في ساكنيها قبل أن يتمّ كبته وختم روحه في داخل جسد طفلٍ رضيع.\",\"release_date\":\"2002-10-03\",\"year\":2002,\"vote_average\":\"8.3\",\"created_at\":\"2026-10-19 15:14:44\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12807\",\"type\":\"series\",\"name\":\"أفلام ناروتو شيبودن مدبلجة\",\"poster\":\"https://image.tmdb.org/t/p/w500/ycTVGD8tHOy2eAe9giFC2SQhA70.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/z0YhJvomqedHF85bplUJEotkN5l.jpg\",\"overview\":\"اوزوماكي ناروتو اصبح الآن اكثر نضجا واكبر عمرا. يسعى لإنقاذ صديقه اوتشيها ساسكي من قبضة أوروتشيمارو. بعد عامين ونصف يعود نارتو أخيراً إلى قريته - كونوها - ويبدأ في وضع طموحاته للعمل، على الرغم من أنه لن يكون سهلاً، حيث أنه جمع عددًا من الأعداء (الأكثر خطورة) مثل الاكاتسكي.\",\"release_date\":\"2007-02-15\",\"year\":2007,\"vote_average\":\"8.5\",\"created_at\":\"2026-10-19 15:02:47\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12804\",\"type\":\"series\",\"name\":\"أفلام ناروتو مدبلجة\",\"poster\":\"https://image.tmdb.org/t/p/original/3MIrM7yU1YL1pknJsLsCuBoVZZw.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/5F0HVEgkgP99fEWDjPyikGt9jQi.jpg\",\"overview\":\"القرية المخفيّة في الورق هي موطن لأكثر النينجا خفّة وسريّة. لكن قبل اثنتي عشرة سنة، ظهر الثعلب الشيطان ذو التسعة ذيول وبعث الرعب في ساكنيها قبل أن يتمّ كبته وختم روحه في داخل جسد طفلٍ رضيع.\",\"release_date\":\"2002-10-03\",\"year\":2002,\"vote_average\":\"8.3\",\"created_at\":\"2026-10-18 23:02:10\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"4962\",\"type\":\"series\",\"name\":\"ناروتو SD مدبلج\",\"poster\":\"https://image.tmdb.org/t/p/w500/4kJRnSOAMYlaA07UzgNkko3wMMH.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/1836hXRxGLS53lImrl3IN002AbD.jpg\",\"overview\":\"أهلاً بكم في قرية الورق المخفية. القرية التي اتخذها أوزوماكي ناروتو، نجم مسلسل \\\"ناروتو\\\"، موطناً له. كل يوم، يقوم عدد لا يحصى من النينجا الأقوياء بمهام ويتدربون لصقل مهاراتهم.\",\"release_date\":\"2012-04-03\",\"year\":2012,\"vote_average\":\"6.4\",\"created_at\":\"2026-07-08 00:47:17\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"4568\",\"type\":\"series\",\"name\":\"ناروتو مدبلج\",\"poster\":\"https://image.tmdb.org/t/p/w500/mLoI2Zto2JYUvSB8PpqvZIV7vWj.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/5F0HVEgkgP99fEWDjPyikGt9jQi.jpg\",\"overview\":\"القرية المخفيّة في الورق هي موطن لأكثر النينجا خفّة وسريّة. لكن قبل اثنتي عشرة سنة، ظهر الثعلب الشيطان ذو التسعة ذيول وبعث الرعب في ساكنيها قبل أن يتمّ كبته وختم روحه في داخل جسد طفلٍ رضيع.\",\"release_date\":\"2002-10-03\",\"year\":2002,\"vote_average\":\"8.3\",\"created_at\":\"2026-07-08 00:37:36\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":23,\"name\":\"أكشن\"},{\"id\":30,\"name\":\"مغامرات\"},{\"id\":31,\"name\":\"قوى خارقة\"},{\"id\":36,\"name\":\"قتال\"},{\"id\":59,\"name\":\"شونين\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"6599\",\"type\":\"series\",\"name\":\"Boruto: Naruto Next Generations\",\"poster\":\"https://image.tmdb.org/t/p/original/x8mOnjRGfHjCJmp0vEmNviz6InS.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/4jDRuUk02VGAVMBJXabI9r0Cj6j.jpg\",\"overview\":\"حياة الشينوبي بدأت تتغيّر. أوزوماكي بوروتو، ابن الهوكاغي السابع ناروتو قد التحق بأكاديمية النينجا ليتعلم طرق النينجا. والآن، بعد أن بدأت سلسلة الأحداث الغامضة تكشف عن ملامحها، قصّة بوروتو على وشك أن تبدأ!\",\"release_date\":\"2017-04-05\",\"year\":2017,\"vote_average\":\"7.8\",\"created_at\":\"2026-07-08 01:55:12\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"7600\",\"type\":\"series\",\"name\":\"Tensei Kizoku, Kantei Skill de Nariagaru\",\"poster\":\"https://image.tmdb.org/t/p/w500/jsugIfxS7mg7G254ZOi6b4jDIgM.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/n493br0MLJHASsqEsUwG5PvxDkN.jpg\",\"overview\":\"بعد إعادة تجسيده، من المفترض أن يعيش آرس لوفينت في عالم مختلف كأرستقراطي ضعيف. كانت قوته البدنية وذكائه متوسطين في كلا العالمين، لكنه هنا يمتلك بطبيعة الحال مهارة تسمى \\\"التقييم\\\". والتي تُمكنه من رؤية إمكانات أي شخص. وهكذا من خلال جمع الأشخاص الموهوبين إلى جانبه، يستخدم آرس مهارة \\\"التقييم\\\" هذه لتحويل منطقته الضعيفة إلى المنطقة الأقوى! لكن الطريق أمامه لن يكون بهذه البساطة، لأن هناك جميع أنواع التحديات التي تنتظرهُ من بينها خسارة من يعزهم ويحبهم.\",\"release_date\":\"2024-04-07\",\"year\":2024,\"vote_average\":\"7.4\",\"created_at\":\"2026-07-08 02:25:44\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"}],\"is_favorite\":false},{\"id\":\"4536\",\"type\":\"series\",\"name\":\"بوروتو: الأجيال القادمة من ناروتو\",\"poster\":\"https://image.tmdb.org/t/p/w500/A7IOcxBxsbUOiwHsGpVl72QtEJJ.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/4jDRuUk02VGAVMBJXabI9r0Cj6j.jpg\",\"overview\":\"حياة الشينوبي بدأت تتغيّر. أوزوماكي بوروتو، ابن الهوكاغي السابع ناروتو قد التحق بأكاديمية النينجا ليتعلم طرق النينجا. والآن، بعد أن بدأت سلسلة الأحداث الغامضة تكشف عن ملامحها، قصّة بوروتو على وشك أن تبدأ!\",\"release_date\":\"2017-04-05\",\"year\":2017,\"vote_average\":\"7.8\",\"created_at\":\"2026-07-08 00:36:36\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12946\",\"type\":\"series\",\"name\":\"Bass X Machina\",\"poster\":\"https://image.tmdb.org/t/p/w500/y9c1AwrldWRsY9edSf21cOgbI0h.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/gpp6NcgfSrxKDivWskRxLp9UadU.jpg\",\"overview\":\"في غربٍ أمريكي تتشابك فيه الآلات والقوى الخارقة للطبيعة، وتنتشر العصابات والخارجون عن القانون، يُجبر أب على أن يكون القاضي والحَكَم والجلاد لحماية أسرته.\",\"release_date\":\"2026-11-03\",\"year\":2026,\"vote_average\":\"7.6\",\"created_at\":\"2026-11-11 00:19:31\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":22,\"name\":\"غربي\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"}],\"is_favorite\":false},{\"id\":\"12934\",\"type\":\"series\",\"name\":\"البدلة المتنقلة جاندام سيد\",\"poster\":\"https://image.tmdb.org/t/p/w500/rWgdDIq4JeaI36KdmLPkYcQjBQ3.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/otE9DjFrKMOv0Mkz1o7HfJGCvNF.jpg\",\"overview\":\"العصر الكوني 71. تطورت البشرية إلى نوعين فرعيين: السكان الأصليون، الذين يعيشون على الأرض، والمنسقون، وهم بشر مُحسَّنون جينيًا قادرون على تحمل قسوة الفضاء ويسكنون المدارات الفضائية.\",\"release_date\":\"2002-10-05\",\"year\":2002,\"vote_average\":\"7.6\",\"created_at\":\"2026-11-02 17:48:17\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"},{\"id\":401,\"name\":\"حرب وسياسة\"}],\"is_favorite\":false},{\"id\":\"12835\",\"type\":\"series\",\"name\":\"ماشيل\",\"poster\":\"https://image.tmdb.org/t/p/original/1rpMnOXe42hkvMN1Dj5Dzsu6NZz.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/p1swd15DRtCnNj20U904dbXeVsi.jpg\",\"overview\":\"هذا عالمٌ من السحر، حيث يُستخدم السحر في كل شيء. لكن في أعماق الغابة، يعيش شابٌ يقضي وقته في التدريب وبناء عضلاته. لا يستطيع استخدام السحر، لكنه ينعم بحياة هادئة.\",\"release_date\":\"2023-04-08\",\"year\":2023,\"vote_average\":\"8.2\",\"created_at\":\"2026-10-29 16:57:22\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12820\",\"type\":\"series\",\"name\":\"موشوكو تينسي\",\"poster\":\"https://image.tmdb.org/t/p/w500/8RukSzEsRnNIPIOQflg5cBwx5f2.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/j9fRIimor0AMFJR9kjZubXcABzZ.jpg\",\"overview\":\"عندما تدهس شاحنة شابًا يبلغ من العمر ٣٤ سنة، لا تنتهي قصته هناك. بل يعاد بعثه في عالم جديد كرضيع، ينتهز \\\"رودي\\\" كلّ فرصة ليعيش الحياة التي لطالما أرادها. مدعومًا بأصدقاء جُدد، وبعض القدرات السحرية المكتسبة حديثًا، والشجاعة لفعل الأشياء التي كان يحلم بها دائمًا، ينطلق في مغامرة ملحمية، مع تذكره لكل تجربته السابقة.\",\"release_date\":\"2021-01-11\",\"year\":2021,\"vote_average\":\"8.4\",\"created_at\":\"2026-10-21 02:58:39\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12811\",\"type\":\"series\",\"name\":\"أفلام بوروتو مترجمة\",\"poster\":\"https://image.tmdb.org/t/p/original/9GB2iXCPVP6bgyQXXPUchX8CD7p.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/4jDRuUk02VGAVMBJXabI9r0Cj6j.jpg\",\"overview\":\"حياة الشينوبي بدأت تتغيّر. أوزوماكي بوروتو، ابن الهوكاغي السابع ناروتو قد التحق بأكاديمية النينجا ليتعلم طرق النينجا. والآن، بعد أن بدأت سلسلة الأحداث الغامضة تكشف عن ملامحها، قصّة بوروتو على وشك أن تبدأ!\",\"release_date\":\"2017-04-05\",\"year\":2017,\"vote_average\":\"7.8\",\"created_at\":\"2026-10-19 16:06:50\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12810\",\"type\":\"series\",\"name\":\"أفلام بوروتو مدبلجة\",\"poster\":\"https://image.tmdb.org/t/p/original/sDiq2Y8wQNC5HsIAAamk27kxQiv.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/4jDRuUk02VGAVMBJXabI9r0Cj6j.jpg\",\"overview\":\"حياة الشينوبي بدأت تتغيّر. أوزوماكي بوروتو، ابن الهوكاغي السابع ناروتو قد التحق بأكاديمية النينجا ليتعلم طرق النينجا. والآن، بعد أن بدأت سلسلة الأحداث الغامضة تكشف عن ملامحها، قصّة بوروتو على وشك أن تبدأ!\",\"release_date\":\"2017-04-05\",\"year\":2017,\"vote_average\":\"7.8\",\"created_at\":\"2026-10-19 15:59:03\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12785\",\"type\":\"series\",\"name\":\"DARK MACHINE: THE ANIMATION\",\"poster\":\"https://image.tmdb.org/t/p/w500/hNNba8tLjCgRGcTSKcB1E0kpBhG.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/fvzlpOEJS2eIPtcIwQi4oYcBwdh.jpg\",\"overview\":\"تأسر الرياضات الإلكترونية الشهيرة DARK MACHINE الناس في جميع أنحاء العالم وقد أحدثت تحولًا في اقتصاد اليابان، حيث توجد منطقة اقتصادية حصرية تسمى \\\"Golden Valley\\\". Ajima هو \\\"Senki\\\" السابع - وهو لقب يُمنح لأقوى لاعب في اللعبة - ويتحكم بشكل فعال في المنطقة من خلال DARK MACHINE. يصل بطل الرواية كايري إلى غولدن فالي وفي ذهنه الكلمات الأخيرة لجده الراحل: \\\"ابحث عن سينكي\\\". ثم يصادف فتاة صغيرة تدعى رودورا، والتي يلاحقها مرؤوس أجيما. يصبح Kairi لاعبًا في DARK MACHINE بعد تواصله مع Rudora، وتزدهر موهبته مع كل معركة شرسة. هل سيتمكن كايري من الصمود أمام سينكي ويحدد مصيره؟\",\"release_date\":\"2026-10-14\",\"year\":2026,\"vote_average\":\"0.0\",\"created_at\":\"2026-10-15 14:25:49\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"}],\"is_favorite\":false},{\"id\":\"12770\",\"type\":\"series\",\"name\":\"كايجو رقم 8: أيام عمل نارومي\",\"poster\":\"https://image.tmdb.org/t/p/w500/sOSI2G20TuQHbfYqwzGXGQXNQHE.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/htGeuCcNhlBe8GTx3izKOsd8frw.jpg\",\"overview\":\"هيبينو كافكا يشتغل في شركة منظفي الوحوش. وهو ابن 32. وعمله تقطيع الوحوش التي أخضعها جند الدفاع وإتلافها. كان كافكا في صغره صديقاً لأشيرو مينا التي وعدها بالانضمام معها إلى جند الدفاع، وحماية اليابان من الوحوش\",\"release_date\":\"2024-04-13\",\"year\":2024,\"vote_average\":\"8.4\",\"created_at\":\"2026-10-11 01:53:33\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"12763\",\"type\":\"series\",\"name\":\"Kyouran Reijou Nia Liston\",\"poster\":\"https://image.tmdb.org/t/p/w500/vsEJaex0keh3dmBC9sVymiKfSwA.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/aNqi7yWUU1blc8kvtfzrkrrYWEE.jpg\",\"overview\":\"يتم إنقاذ فتاة تحتضر عندما توضع روح المحارب الساقط في جسدها، مما يمنحها حياة جديدة وقوى شفاء وتعطشًا لا يمكن إيقافه للمعركة التي تجلب الفوضى في أعقابها.\",\"release_date\":\"2026-10-06\",\"year\":2026,\"vote_average\":\"6.0\",\"created_at\":\"2026-10-10 01:30:11\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"}],\"is_favorite\":false},{\"id\":\"12750\",\"type\":\"series\",\"name\":\"Mezametara Saikyou Soubi to Uchuusenmochi Datta node, Ikkodate Mezashite Youhei toshite Jiyuu ni Ikitai\",\"poster\":\"https://image.tmdb.org/t/p/w500/uF5ls69ae5oskSCGcEGtXgwHy6N.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/xqil5t29q1k6reedUlMy4nYd9f7.jpg\",\"overview\":\"عندما يستيقظ موظف المكتب تاكاهيرو ساتو داخل لعبة الخيال العلمي المفضلة لديه، يجد نفسه يقود سفينة فضاء قوية. يصعد إلى النجوم بصفته هيرو المرتزق، ويقاتل الأعداء ويجمع الحلفاء على طول الطريق. لكنه سرعان ما يواجه مشكلة كبيرة: ليس لديه منزل، والأهم من ذلك، لا مشروبات غازية! هناك شيء واحد فقط يجب فعله...أن يشتري لنفسه منزلاً على الكوكب!\",\"release_date\":\"2026-10-04\",\"year\":2026,\"vote_average\":\"0.0\",\"created_at\":\"2026-10-10 00:42:03\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"27095\",\"type\":\"movie\",\"name\":\"PAW Patrol: The Dino Movie\",\"poster\":\"https://image.tmdb.org/t/p/w500/qnin56Syy5rbG7KCaxWY7SPuy6p.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/6TSxLmwT7j1ugtKi8NyMmdzWAGj.jpg\",\"overview\":\"بعد عاصفة قوية، تهبط دورية المخلب على جزيرة ديناصورات غامضة، حيث يلتقون بالجرو ريكس، ويواجهون خطر بركان سببه تعدين العمدة هامدينجر، ليخوضوا أكبر مهمة لإنقاذ الجزيرة.\",\"release_date\":\"2026-07-23\",\"year\":2026,\"vote_average\":\"7.8\",\"created_at\":\"2026-09-19 16:37:10\",\"dub\":false,\"categories\":[{\"id\":6,\"name\":\"أفلام أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":3,\"name\":\"عائلي\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":402,\"name\":\"مغامرة\"},{\"id\":404,\"name\":\"فانتازيا\"}],\"is_favorite\":false}],\"count\":24,\"total\":88,\"page\":1,\"per_page\":24,\"total_pages\":4,\"has_more\":true}"},"redirectURL":"","headersSize":-1,"bodySize":5641}},{"startedDateTime":"2026-11-27T14:32:36.465871Z","time":105,"pageref":"ProxyPin","_id":"mwz2z2i9lhc6ehZF","_app":{"id":"com.anime.day","name":"Anime Day","path":"com.anime.day","os":"android"},"request":{"method":"GET","url":"https://image.tmdb.org/t/p/original/cHhJzdUGcEBq6av4wr9jsIvUITH.jpg","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"User-Agent","value":"Dalvik/2.1.0 (Linux; U; Android 14; M2006C3MG Build/UQ1A.240205.004)"},{"name":"Host","value":"image.tmdb.org"},{"name":"Connection","value":"Keep-Alive"},{"name":"Accept-Encoding","value":"gzip"}],"queryString":[],"postData":{"mimeType":"","text":""},"headersSize":-1,"bodySize":0},"cache":{},"timings":{"send":0,"wait":105,"receive":0},"serverIPAddress":"143.244.56.52","response":{"_responseAvailable":true,"_originalContentEncoding":null,"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Date","value":"Fri, 27 Nov 2026 14:32:36 GMT"},{"name":"Content-Type","value":"image/jpeg"},{"name":"Content-Length","value":"316339"},{"name":"Connection","value":"keep-alive"},{"name":"Server","value":"BunnyCDN-FR1-1215"},{"name":"CDN-PullZone","value":"775336"},{"name":"CDN-RequestCountryCode","value":"MA"},{"name":"Cache-Control","value":"public, max-age=31919000"},{"name":"Last-Modified","value":"Thu, 08 Jan 2026 14:40:14 GMT"},{"name":"X-BO-Server","value":"LA-291"},{"name":"X-DownloadSize","value":"470798"},{"name":"X-B