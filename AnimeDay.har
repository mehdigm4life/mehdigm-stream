يرة \\\"ليليث\\\"، أخت \\\"سندريلا\\\" غير الشقيقة، عصا العرّابة السحرية… وتغيّر أحداث القصة التي نعرفها.\",\"keywords\":\"أختان غير شقيقتين اختان غير شقيقتين\",\"runtime\":107,\"release_date\":\"2026-11-20\",\"year\":2026,\"vote_average\":\"6.0\",\"views\":0,\"tmdb_id\":1595124,\"imdb_id\":\"\",\"poster\":\"https://image.tmdb.org/t/p/w500/jtfCcWZ3ZyKdgi0u7JVOxEOSSJP.jpg\",\"cover\":\"https://image.tmdb.org/t/p/w500/jtfCcWZ3ZyKdgi0u7JVOxEOSSJP.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/g1bEboMx1a8JCg1jXeDCh24RtgW.jpg\",\"trailer\":\"tNV4i3BqUGY\",\"featured\":false,\"dub\":false,\"is_favorite\":false,\"watched\":false,\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":3,\"name\":\"عائلي\"},{\"id\":16,\"name\":\"رسوم متحركة\"}],\"categories\":[{\"id\":6,\"name\":\"أفلام أنمي وكرتون\",\"type\":\"movie\"}]}}"},"redirectURL":"","headersSize":-1,"bodySize":757}},{"startedDateTime":"2026-11-27T14:32:52.512966Z","time":478,"pageref":"ProxyPin","_id":"mwz2zew0tbfSv1aN","_app":{"id":"com.anime.day","name":"Anime Day","path":"com.anime.day","os":"android"},"request":{"method":"GET","url":"https://20042026.site/v3.8/api/series/12939","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"firebase_id","value":".IJX2uhEG7uJMCj7j."},{"name":"Host","value":"20042026.site"},{"name":"Connection","value":"Keep-Alive"},{"name":"Accept-Encoding","value":"gzip"},{"name":"User-Agent","value":"okhttp/4.10.0"}],"queryString":[],"postData":{"mimeType":"","text":""},"headersSize":-1,"bodySize":0},"cache":{},"timings":{"send":0,"wait":478,"receive":0},"serverIPAddress":"188.114.96.5","response":{"_responseAvailable":true,"_originalContentEncoding":"gzip","status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Date","value":"Fri, 27 Nov 2026 14:32:52 GMT"},{"name":"Content-Type","value":"application/json; charset=UTF-8"},{"name":"Connection","value":"keep-alive"},{"name":"Server","value":"cloudflare"},{"name":"vary","value":"Accept-Encoding"},{"na