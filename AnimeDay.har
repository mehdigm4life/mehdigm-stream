e=31536000"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"Content-Encoding","value":"gzip"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"Server-Timing","value":"cfCacheStatus;desc=\"DYNAMIC\""},{"name":"Server-Timing","value":"cfEdge;dur=21,cfOrigin;dur=124"},{"name":"Report-To","value":"{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=6ZIah4gmOw2v8gIPiTmIoQIiYv96nuov9XajkiF8R1%2BYjuF7bJJpyo11exqs6gCCvaM3TVyGGkeu2WipHz52KSO5fsEu3XTvLaylkAh355FJUFGh7v8X3K7syOYtDngs\"}]}"},{"name":"Nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"CF-RAY","value":"a611d903ba593d05-MAD"},{"name":"Content-Length","value":"1447"}],"content":{"size":1447,"mimeType":"application/json","text":"{\"status\":true,\"auth\":false,\"version\":\"3.8\",\"force_update\":0,\"name\":false,\"email\":false,\"photo_url\":false,\"is_subscribed\":false,\"created_date\":false,\"data\":[],\"series\":{\"id\":\"12939\",\"type\":\"series\",\"name\":\"ون بيس - دبلجة نتفليكس\",\"original_name\":\"One Piece\",\"tagline\":\"\",\"overview\":\"قبل سنوات عديدة، تم إعدام ملك القراصنة - جول دي روجر - تاركا وراءه كومة ضخمة من الكنوز و الون بيس - القطعه الواحده -  الشهيرة. من يجدها سيكون اسمه ملك القراصنة الجديد. مونكي دي لوفي، وهو صبي الذي استهلك واحدة من فواكه الشيطان، يعتقد أنه سوف يسير على خطى القرصان شانكس، ويجد الون بيس. محاط بسرب من المقاتلين الماهرين واللصوص على طول الطريق. يحضر مونكي دي لوفي حفنة من طاقمه يتبعونه، رورونوا زورو، نامي، اوسوب، سانجي، تشوبر، نيكو روبن، فرانكي وبروك. سوف يفعلون أي شيء للحصول على الون بيس!\",\"keywords\":\"عمك عمي  ون بيس ون بيس ونبيس وان بيس وان بيس ونبيز ون بيز القطعة الواحدة القطعه الواحده قطعة واحدة قطعه واحده ワンピース wan pīsu wan pisu one piece onepiece إيتشيرو أودا ايتشيرو اودا إيشيرو أودا ايشيرو اودا eiichiro oda eiichirō oda مونكي دي لوفي منكي دي لوفي مانكي دي لوفي لوفي لوفى monkey d. luffy luffy رورونوا زورو زورو roronoa zoro zoro نامي نامى nami أوسوب اوسوب يوسوب usopp سانجي سانجى sanji توني توني تشوبر تشوبر شوبر tony tony chopper chopper نيكو روبن روبن nico robin فرانكي فرانكى franky بروك brook جينبي جينبى jinbe شانكس shanks بورتغاس دي آيس بورتغاس دي ايس آيس ايس portgas d. ace ace غول دي روجر جول دي روجر gol d. roger مايومي تاناكا مايومى تاناكا mayumi tanaka قراصنة قراصنه قرصان قبعة القش قبعه القش طاقم قبعة القش طاقم قبعه القش straw hat pirates فاكهة الشيطان فاكهه الشيطان devil fruit ملك القراصنة ملك القراصنه الكنز كنز البحر الخط العظيم grand line أنمي انمي انمى أنمي ياباني انمي ياباني ياباني\",\"number_of_seasons\":1,\"number_of_episodes\":130,\"release_date\":\"1999-10-20\",\"year\":1999,\"vote_average\":\"8.8\",\"tmdb_id\":37854,\"poster\":\"https://image.tmdb.org/t/p/original/yUFnZBOVVzB2RwcYR0jAe8LDMim.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/2rmK7mnchw9Xr3XdiTFSxTTLXqv.jpg\",\"trailer\":\"\",\"featured\":true,\"dub\":true,\"is_favorite\":false,\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\",\"type\":\"tv-show\"}]}}"},"redirectURL":"","headersSize":-1,"bodySize":1447}},{"startedDateTime":"2026-11-27T14:33:15.133552Z","time":-1,"pageref":"ProxyPin","_id":"mwz2zwcdTBNQPLKc","_app":{"id":"com.anime.day","name":"Anime Day","path":"com.anime.day","os":"android"},"request":{"method":"GET","url":"https://serv-stream-cdn50.cdn-video.xyz/hls2/02/00084/a72ibmtlol7i_x/seg-1-v1-a1.ts?t=lS_RzzKwzq5S9qGbTwE3gCtSC4NsDb4qfbe_rskWGjQ&s=1795789982&e=86400&f=421360&srv=c31&i=0.0&sp=4000&p1=serv-stream-cdn50&p2=serv-stream-cdn50","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Referer","value":"https://down.vidtube.one/"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/70.0.3538.77 Safari/537.36"},{"name":"Accept-Encoding","value":"identity"},{"name":"Host","value":"serv-stream-cdn50.cdn-video.xyz"},{"name"