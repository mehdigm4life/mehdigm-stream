image|fr|sp|14400|z7gkeBtOI|nl51kmjiTPv9jbsOu|aA_JjU3MCyWUTCf|m3u8|master|urlset|9gi5rojzsh1k_|hls2|sources|setup'.split('|')))\n</script>\n\n\n\n<script src=\"/js/pop.js\"></script>\n<Script>\n$(function() {\n \n\tif( window.cRAds === undefined ){ $('#adbd').css('display','table'); }\n\n\t\n \n});\n</Script>\n\n\n<!-- pop diagnostics v3 (2026-09-10): can the popunder open at all on this embedder?\n     Installed BEFORE the ad tag. Samples 25% of loads, watches the WHOLE session and\n     reports ONE Plausible event (20s after the first real click, or on page hide):\n        Pop Fired       - window.open returned a window (pop works here)\n        Pop Blocked     - window.open was called and returned null => sandboxed\n        Pop Fired Focus - no open() seen, but the page lost focus within 3s of a click\n        Pop No Attempt  - nothing tried (no fill, capped, or the tag was blocked)\n     Plausible stores the referrer on custom events, so the per-embedder rate comes from\n     GROUP BY domainWithoutWWW(referrer). Purely observational: window.open is called\n     through unchanged and its return value / exceptions are passed straight back. -->\n<script>\n(function(){\n  try{\n    if(Math.random() >= 0.25) return;   // 25% sample - keeps event volume sane\n    var attempted=false, opened=false, focusLost=false, clicked=0, done=false, timer=null;\n\n    var _open = window.open;\n    if(typeof _open === 'function'){\n      window.open = function(){\n        attempted = true;\n        var w = _open.apply(window, arguments);   // exceptions propagate unchanged\n        if(w) opened = true;\n        return w;\n      };\n    }\n    // a pop that dodges the hook still steals focus - catch that within 3s of a click\n    function maybeFocusLost(){ if(clicked && (Date.now()-clicked) < 3000) focusLost = true; }\n    window.addEventListener('blur', maybeFocusLost, true);\n    document.addEventListener('visibilitychange', function(){ if(document.hidden) maybeFocusLost(); }, true);\n\n    function report(){\n      if(done) return; done = true;\n      var name = opened   ? 'Pop Fired'          // window.open returned a window\n               : attempted  ? 'Pop Blocked'        // window.open called, returned null\n               : focusLost  ? 'Pop Fired Focus'    // something opened without our hook seeing it\n               :              'Pop No Attempt';\n      try{ if(window.plausible) window.plausible(name); }catch(e){}\n    }\n    document.addEventListener('click', function(e){\n      if(!e || !e.isTrusted) return;\n      clicked = Date.now();\n      if(!timer) timer = setTimeout(report, 20000);   // whole-session view, not just click 1\n    }, true);\n    window.addEventListener('pagehide', function(){ if(clicked) report(); });\n  }catch(e){}\n})();\n</script>\n\n<!-- Ads: served from the Ads table = admin Ads Management panel (?op=my_ads).\n     2026-09-15: the hardcoded rotating loader was removed on owner request; all ad\n     delivery on embeds, landing and /d/ now comes from that one panel. -->\n\t<script data-cfasync=\"false\" src=\"https://pgo99.com/1/e75aa56ff8c1c1e201509ee1bfeaf015\"></script>\n<script data-cfasync=\"false\">(function(){var s=document.createElement(\"script\");s.src=\"/k5km3/h8n907kh.js\";s.async=true;s.onload=function(){try{aclib.runPop({zoneId:\"12183638\"});}catch(e){}};(document.head||document.documentElement).appendChild(s);})();</script>\n<script data-cfasync=\"false\" async type=\"text/javascript\" src=\"/h3k9m/k4m8g2n6.js\"></script>\n<script type=\"text/javascript\" src=\"/k4300/mnk5889h.js?v=4\" data-ts-vertical=\"mainstream\" data-ts-spot=\"6851bf7569124c878aabe59bd5c91d82\" data-ts-type=\"tabup\" data-ts-session-duration=\"30\" data-ts-count=\"3\" data-ts-delay=\"5\" async defer></script>\n<script data-cfasync=\"false\" async type=\"text/javascript\" src=\"//eo.todditehexarch.com/s7OTtYZQx47iED/156249\"></script>\n<!-- Ads end -->\n\n\n<!-- sandbox wall: always rendered, independent of ad settings (mobile-safe) -->\n<!-- TrafficStars adult VAST preroll 2026-10-09: adult embeds only (index_dl.pm, ts_vast_* config). Tag host = rotating\n     domainator domain (/js2/tsd.txt), spot picked per embedding site. JW8 VAST client enabled in JW8.pm (uq_vast_tag);\n     the ad is started here with playAd() on the first play so the cap lives client-side (3rd-party cookies are blocked). -->\n<script>\n(function(){\n  try{\n    var TAG=\"https://pefimatupajany.com/do2/d058c89a33ff454e96c7c7cf7d5848fc/vast?subid=uqload.vc\", CAP_MS=4*3600*1000, KEY='uqtv_ts';\n    function ev(n,p){ try{ if(window.plausible) window.plausible(n, {props:Object.assign({net:'ts'}, p||{})}); }catch(e){} }\n    function capped(){ try{ var t=+localStorage.getItem(KEY)||0; return (Date.now()-t) < CAP_MS; }catch(e){ return false; } }\n    function mark(){ try{ localStorage.setItem(KEY, String(Date.now())); }catch(e){} }\n    var tries=0;\n    (function hook(){\n      var p=null; try{ p=window.jwplayer && jwplayer(); }catch(e){}\n      if(!p || typeof p.on!=='function' || typeof p.getState!=='function'){ if(++tries<150) setTimeout(hook,200); return; }\n      var done=false;\n      p.on('beforePlay', function(){\n        if(done) return; done=true;\n        if(capped()) return;\n        mark();\n        try{ p.playAd(TAG); }catch(e){ ev('Preroll Dropped',{reason:'playad-throw'}); }\n      });\n      p.on('adImpression', function(){ ev('Preroll Impression'); });\n      p.on('adClick',      function(){ ev('Preroll Click',{via:'video'}); });\n      p.on('adSkipped',    function(){ ev('Preroll Skipped'); });\n      p.on('adError',      function(e){ ev('Preroll Dropped',{reason:'ad-error-'+((e && (e.code||e.message))||'x')}); });\n    })();\n  }catch(e){}\n})();\n</script>\n\n\n<!-- Javascript Alt Ads code start -->\n\t\n\t<script>console.log('AD1');</script>\n\t<script>console.log('AD2');</script>\n\t<script>console.log('AD3');</script>\n<!-- Javascript Alt Ads code end -->\n\n\n\n<!-- playback telemetry: independent of the view counters, fires into Plausible -->\n<script>\n(function(){\n  try{\n    var attempted=false, succeeded=false, stalled=null;\n    function ev(name,props){\n      try{ if(window.plausible) window.plausible(name, props?{props:props}:undefined); }catch(e){}\n    }\n    // media events do not bubble - capture on document catches any <video> the player creates\n    document.addEventListener('play', function(){\n      if(attempted) return; attempted=true;\n      ev('Play Attempt');\n      // if nothing is playing 10s after the attempt, record the failure explicitly\n      stalled = setTimeout(function(){ if(!succeeded) ev('Play Blocked'); }, 10000);\n    }, true);\n\n    function ok(e){\n      if(succeeded) return;\n      var t = e && e.target && e.target.currentTime;\n      if(!(t > 0.5)) return;            // real progress, not just a ready event\n      succeeded=true;\n      if(stalled) clearTimeout(stalled);\n      if(!attempted){ attempted=true; ev('Play Attempt'); }   // autoplay path\n      ev('Play Success');\n    }\n    document.addEventListener('timeupdate', ok, true);\n    document.addEventListener('playing',  ok, true);\n  }catch(e){}\n})();\n</script>\n\n\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"c3f9779449114c958e42dd11552785ba\",\"r\":1,\"spa\":2}' crossorigin=\"anonymous\"></script>\n</BODY></HTML>\n"},"redirectURL":"","headersSize":-1,"bodySize":12961}},{"startedDateTime":"2026-11-27T14:33:29.544694Z","time":234,"pageref":"ProxyPin","_id":"mwz307goTqAzt5dv","_app":{"id":"com.anime.day","name":"Anime Day","path":"com.anime.day","os":"android"},"request":{"method":"GET","url":"https://20042026.site/v3.8/api/episode/382757/servers","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"n