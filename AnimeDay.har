alue":"h3=\":443\"; ma=86400"},{"name":"Content-Length","value":"12961"}],"content":{"size":12961,"mimeType":"text/html","text":"<HTML>\n<HEAD>\n<link rel=\"stylesheet\" href=\"/css/main.css\">\n<script src=\"/js/jquery.min.js\"></script>\n<script src=\"/js/xupload.js\"></script>\n<script src=\"/js/jquery.cookie.js\"></script>\n<script>\n$.cookie('file_id', '28581467', { expires: 10 });\n$.cookie('aff', '152699', { expires: 10 });\n$.cookie('ref_url', 'uqload.vc', { expires: 10 });\n</script>\n<script src=\"/77j29/070jgj51.js\"></script>\n<!-- Privacy-friendly analytics by Plausible --><script async src=\"/k7r2w/x9m4q1.js\"></script><script>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()</script></head>\n<BODY topmargin=0 leftmargin=0 style=\"background:transparent;\">\n<!-- 2026-10-30 sbx2 sandbox block + smartlink overlay: must stay first in BODY -->\n\n\n\n\n\t<!-- 2026-10-06 ad-block wall (WALL=1). Every page also reports what each probe found (Plausible \"Adblock Probe\").\n     ?adbdebug=1 shows a results panel (and still shows the wall). Not included at all when the page has no ad tags.\n     Probes: bait  = first-party /ad/pop.adsbox.js did not run (window.cRAds unset)\n             elem  = ad-classed bait box collapsed by cosmetic filters\n             google= no-cors fetch of Google's ad script rejected (Brave Shields / uBlock / Pi-hole)\n             adfail/adok = ad-network script tags that errored / loaded (window capture listeners, set before the ad tags) -->\n<style>\n#uqab318524{display:none;position:fixed;inset:0;z-index:2147483647;background:#000;color:#fff;\n font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;text-align:center;align-items:center;justify-content:center;padding:16px;box-sizing:border-box}\n#uqab318524 .lk{font-size:34px;line-height:1;margin-bottom:10px}\n#uqab318524 h2{margin:0 0 8px;font-size:20px;font-weight:800;color:#fff!important}\n#uqab318524 p{margin:0 auto 14px;max-width:420px;font-size:13px;line-height:1.45;font-weight:500;color:#ddd!important}\n#uqab318524 button{background:#00ADEF;color:#fff;border:0;border-radius:6px;padding:7px 18px;font-size:13px;font-weight:700;cursor:pointer}\n#uqabdbg{position:fixed;left:8px;bottom:8px;z-index:2147483647;background:rgba(0,0,0,.85);color:#0f0;font:12px/1.45 monospace;padding:8px 10px;border-radius:6px;max-width:94vw;white-space:pre-wrap}\n@media (max-height:300px){#uqab318524 .lk{font-size:22px;margin-bottom:4px}#uqab318524 h2{font-size:15px;margin-bottom:4px}#uqab318524 p{font-size:11px;margin-bottom:8px}}\n</style>\n<script>\n(function(){\n  var WALL = 0;   // 2026-10-06 21:5x local: SILENT per owner (wall cost ~35% of mainstream plays); was ON 19:30-21:5x (rule validated: ABP/uBO via google/elem/bait, Brave via navigator.brave + our ad scripts blocked)\n  var ON = 1;\n  var SOFT = 0;   // 2026-10-12 owner: non-blocking 'disable ad blocker or go Premium' card\n  var DEBUG = /[?&]adbdebug=1/.test(location.search);\n  var REF = 'uqload.vc' || 'direct';\n  var LS='uqab_walled';\n  function ev(n,props){ try{ if(window.plausible) window.plausible(n,{props:props}); }catch(e){} }\n  function lsGet(){ try{ return localStorage.getItem(LS); }catch(e){ return null; } }\n  function lsSet(v){ try{ if(v) localStorage.setItem(LS,v); else localStorage.removeItem(LS); }catch(e){} }\n  var AD = /scrubsrha|uniolaicecaps|engracelithest|propylamoile|todditehexarch|rapidfire|buzukiabateful|heatenpyropus|4xfreedom|benchform|pgo99|namebrain|autorepairworcester|vitting|mayhemsrewind|runative-syndicate|biomanos|dcengg|fallpane|quge5|kokamamimmest|glusidesneezes|\\/r[0-9a-f]{8,}\\/(?:153453|152863)/i;\n  var R = {bait:'?', elem:'?', google:'?', net:'?', brave:'no', adfail:{}, adok:{}}, shown=false, reported=false;\n  try{ if(navigator.brave && navigator.brave.isBrave){ R.brave='yes'; } }catch(e){}\n  // Reload button: our window-level capture listeners are registered BEFORE the async pop scripts, so a press on the\n  // button is handled here first (pop networks listening on window/document were swallowing the button's own onclick).\n  var reloading=false;\n  function wallBtnHit(e){\n    if(!shown) return false;\n    var b=document.querySelector('#uqab318524 button'); if(!b) return false;\n    var p=(e.touches&&e.touches[0])||(e.changedTouches&&e.changedTouches[0])||e, x=p.clientX, y=p.clientY;\n    var r=b.getBoundingClientRect();\n    return (e.target===b || b.contains(e.target) || (x!=null && x>=r.left-6 && x<=r.right+6 && y>=r.top-6 && y<=r.bottom+6));\n  }\n  ['pointerdown','mousedown','touchstart','pointerup','mouseup','touchend','click'].forEach(function(tp){\n    window.addEventListener(tp,function(e){\n      if(!wallBtnHit(e)) return;\n      e.stopImmediatePropagation(); e.preventDefault();\n      if((tp==='click'||tp==='pointerup'||tp==='touchend'||tp==='mouseup') && !reloading){\n        reloading=true; ev('Adblock Wall Reload',{site:REF}); setTimeout(function(){ location.reload(); },120);\n      }\n    },{capture:true,passive:false});\n  });\n  // any other press on the wall itself is swallowed too, so pops can't fire through the black screen\n  window.addEventListener('click',function(e){ if(shown){ var d=document.getElementById('uqab318524'); if(d && d.contains(e.target)){ e.stopImmediatePropagation(); } } },true);\n  function hostOf(src){ var m=String(src).match(AD); return m ? m[0].toLowerCase() : null; }\n  window.addEventListener('error',function(e){ var t=e&&e.target; if(t&&t.tagName==='SCRIPT'&&t.src){ var h=hostOf(t.src); if(h){ R.adfail[h]=1; early(); } } },true);\n  // element 'load' events never reach window (spec), so listen on document in capture phase\n  document.addEventListener('load', function(e){ var t=e&&e.target; if(t&&t.tagName==='SCRIPT'&&t.src){ var h=hostOf(t.src); if(h) R.adok[h]=1; } },true);\n  // 2026-10-12 owner: SOFT prompt (WALL off, uploader opted in). Small card at the bottom; the video keeps playing.\n  // Dismiss is remembered 24 h on this browser. Plausible \"Adblock Soft\" step=shown/premium/dismiss.\n  var softShown=false;\n  function soft(why){\n    if(softShown) return; softShown=true;\n    try{ var t=+localStorage.getItem('uqab_soft')||0; if(Date.now()-t<864e5) return; }catch(e){}\n    ev('Adblock Soft',{step:'shown', why:why, site:REF});\n    var fr=/^fr/i.test(navigator.language||'');\n    var d=document.createElement('div');\n    d.setAttribute('style','position:fixed;left:50%;bottom:14px;transform:translateX(-50%);z-index:2147483647;max-width:92%;width:440px;'\n      +'background:rgba(5,12,28,.92);border:1px solid rgba(125,184,255,.4);border-radius:14px;padding:12px 14px;color:#fff;'\n      +'font:13px/1.4 Inter,system-ui,-apple-system,\"Segoe UI\",sans-serif;box-shadow:0 8px 30px rgba(0,0,0,.5);text-align:left');\n    d.innerHTML='<div style=\"font-weight:700;font-size:14px;margin-bottom:4px\">'+(fr?'Bloqueur de pub détecté':'Ad blocker detected')+'</div>'\n      +'<div style=\"opacity:.85\">'+(fr?'Uqload est gratuit grâce à la publicité. Merci de désactiver votre bloqueur de pub.'\n                                     :'Uqload is free thanks to ads. Please turn off your ad blocker.')+'</div>'\n      +'<div style=\"display:flex;gap:8px;margin-top:10px;justify-content:flex-end\">'\n      +'<button type=\"button\" style=\"background:transparent;color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:7px 14px;font:inherit;cursor:pointer\">'+(fr?'Continuer':'Continue')+'</button></div>';\n    d.querySelector('button').addEventListener('click',function(){ ev('Adblock Soft',{step:'dismiss', site:REF}); try{ localStorage.setItem('uqab_soft',String(Date.now())); }catch(e){} d.remove(); });\n    (document.body||document.documentElement).appendChild(d);\n  }\n  function show(){\n    if(!ON || shown) return;\n    if(!WALL){ if(SOFT) soft(arguments[0]||'adblock'); return; }\n    shown=true;\n    var why = arguments[0]||'adblock';\n    ev('Adblock Wall',{why:why, site:REF});\n    lsSet(String(Date.now())+'|'+why);\n    var fr=/^fr/i.test(navigator.language||'');\n    var d=document.createElement('div'); d.id='uqab318524';\n    d.innerHTML='<div><div class=\"lk\">&#128274;</div><h2>'+(fr?'Bloqueur de pub détecté':'Ad Blocker Detected')+'</h2>'+\n      '<p>'+(fr?'Merci de désactiver votre bloqueur de pub pour regarder cette vidéo. Une fois désactivé, rechargez la page.'\n              :'Please disable your ad blocker to watch this video. Once disabled, reload the page to continue.')+'</p>'+\n      '<button type=\"button\">'+(fr?'Recharger':'Reload')+'</button></div>';\n    d.querySelector('button').onclick=function(){ if(!reloading){ reloading=true; ev('Adblock Wall Reload',{site:REF}); setTimeout(function(){ location.reload(); },120); } };\n    (document.body||document.documentElement).appendChild(d); d.style.display='flex';\n    try{ if(window.jwplayer && jwplayer().pause) jwplayer().pause(true); }catch(e){}\n    document.addEventListener('play',function(e){ try{ e.target.pause(); }catch(x){} },true);\n  }\n  function verdict(){\n    var nf=Object.keys(R.adfail).length, nok=Object.keys(R.adok).length;\n    // 10-06 real-traffic check: google/elem/bait = 26.7% of visitors (matches the known ~27% ad-block rate) -> reliable.\n    // \"ad scripts failed, none loaded\" alone = 24.3% (network/ISP failures too) -> only trusted inside Brave, whose Shields\n    // let the Google fetch + bait box through but block our ad networks.\n    // Brave Shields block some of our ad networks but may let others load (e.g. ShuffleBox) -> any failure counts in Brave\n    var braveShields = (R.brave==='yes' && nf>=1);\n    // 10-06: uBlock Origin (Firefox) passes google (surrogate redirect) + bait box but blocks our ad scripts. Logged only for now:\n    var adsOnlyBlocked = (R.brave!=='yes' && nf>=1 && nok===0 && R.net==='ok');\n    var blocked = (R.google==='blocked') || (R.elem==='hidden') || (R.bait==='blocked') || braveShields;\n    return {blocked:blocked, nf:nf, nok:nok, brave:braveShields, adsonly:adsOnlyBlocked};\n  }\n  // decide as soon as any probe is conclusive, so the wall is up before the viewer can start the video\n  // instant probes (google/elem/bait) decide at once; the Brave rule waits until 2.5 s so the other ad scripts had a chance to load\n  // (an ad network briefly down must never wall a Brave user whose Shields are off)\n  // window.adbon is what the player's op=view ping reports (JW8.pm: adb=1) -> Views.adb -> payout rule m5 (adb_money_percent)\n  function early(){ try{ var v=verdict(); if(v.blocked && !v.brave){ window.adbon=1; show('adblock'); } }catch(e){} }\n  setTimeout(function(){ try{ var v=verdict(); if(v.blocked){ window.adbon=1; show(v.brave?'brave':'adblock'); } }catch(e){} }, 2500);\n  function report(){\n    if(reported) return; reported=true;\n    var v=verdict();\n    try{ if(window.plausible) window.plausible('Adblock Probe',{props:{blocked:String(v.blocked),google:R.google,elem:R.elem,bait:R.bait,brave:R.brave,net:R.net,adsonly:String(v.adsonly&&!v.blocked),adfail:String(v.nf),adok:String(v.nok)}}); }catch(e){}\n    if(DEBUG){\n      var p=document.createElement('div'); p.id='uqabdbg';\n      p.textContent='AD-BLOCK DEBUG\\n google fetch : '+R.google+'\\n bait element : '+R.elem+'\\n bait script  : '+R.bait+'\\n brave browser: '+R.brave+'\\n neutral net  : '+R.net+\n        '\\n ad scripts failed: '+(Object.keys(R.adfail).join(', ')||'none')+'\\n ad scripts loaded: '+(Object.keys(R.adok).join(', ')||'none')+\n        '\\n => verdict: '+(v.blocked?('AD BLOCKER'+(v.brave?' (Brave Shields)':'')):'clean')+(v.adsonly&&!v.blocked?'  [ads-only block: would be walled by the uBlock rule]':'')+'   (wall '+(WALL?'ON':'off')+', page eligible '+(ON?'yes':'no')+')';\n      (document.body||document.documentElement).appendChild(p);\n    }\n    if(v.blocked){ window.adbon=1; show(v.brave?'b