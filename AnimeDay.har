":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"4962\",\"type\":\"series\",\"name\":\"ناروتو SD مدبلج\",\"poster\":\"https://image.tmdb.org/t/p/w500/4kJRnSOAMYlaA07UzgNkko3wMMH.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/1836hXRxGLS53lImrl3IN002AbD.jpg\",\"overview\":\"أهلاً بكم في قرية الورق المخفية. القرية التي اتخذها أوزوماكي ناروتو، نجم مسلسل \\\"ناروتو\\\"، موطناً له. كل يوم، يقوم عدد لا يحصى من النينجا الأقوياء بمهام ويتدربون لصقل مهاراتهم.\",\"release_date\":\"2012-04-03\",\"year\":2012,\"vote_average\":\"6.4\",\"created_at\":\"2026-07-08 00:47:17\",\"dub\":true,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":217,\"name\":\"خيال علمي وفانتازيا\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"6599\",\"type\":\"series\",\"name\":\"Boruto: Naruto Next Generations\",\"poster\":\"https://image.tmdb.org/t/p/original/x8mOnjRGfHjCJmp0vEmNviz6InS.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/w780/4jDRuUk02VGAVMBJXabI9r0Cj6j.jpg\",\"overview\":\"حياة الشينوبي بدأت تتغيّر. أوزوماكي بوروتو، ابن الهوكاغي السابع ناروتو قد التحق بأكاديمية النينجا ليتعلم طرق النينجا. والآن، بعد أن بدأت سلسلة الأحداث الغامضة تكشف عن ملامحها، قصّة بوروتو على وشك أن تبدأ!\",\"release_date\":\"2017-04-05\",\"year\":2017,\"vote_average\":\"7.8\",\"created_at\":\"2026-07-08 01:55:12\",\"dub\":false,\"categories\":[{\"id\":5,\"name\":\"مسلسلات أنمي وكرتون\"}],\"genres\":[{\"id\":1,\"name\":\"كوميديا\"},{\"id\":16,\"name\":\"رسوم متحركة\"},{\"id\":390,\"name\":\"حركة ومغامرة\"}],\"is_favorite\":false},{\"id\":\"4536\",\"type\":\"series\",\"name\":\"بوروتو: الأجيال القادمة من ناروتو\",\"poster\":\"https://image.tmdb.org/t/p/w500/A7IOcxBxsbUOiwHsGpVl72QtEJJ.jpg\",\"backdrop\":\"https://image.tmdb.or